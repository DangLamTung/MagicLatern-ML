# Host-test binaries: built by `make` in se/hosttest, no extension so the
# repo-wide *.bin / *.elf patterns do not catch them.
se/hosttest/se_cam_test
se/hosttest/grade_jpeg
se/hosttest/rawdev
se/hosttest/mrawtest
se/hosttest/savechain
se/hosttest/yuvsave_test
se/hosttest/keeptest
se/hosttest/lookmatch
se/hosttest/*.o
se/hosttest/*.d

# Build output
build/

# Simulation renders and scratch images (tens of MB, regenerated by simulate_ui.py)
tools/sim/out_*/
tools/sim/*.ppm
tools/sim/*.png

# Frame dumps and slot backups copied off the camera
*.BIN
SLOT*.BIN

# Calibration output: regenerate with tools/calib/calibrate.py
modules/film_sim/tools/calib/out/
